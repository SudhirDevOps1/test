# =============================================================================
#  Copy to .env for LOCAL `docker run --env-file` testing only.
#
#      cp .env.example .env
#
#  NEVER commit .env - .gitignore already blocks it. On Hugging Face these go
#  into Settings -> Variables and Secrets, never into a file in the repo.
#
#  The split below mirrors exactly how Hugging Face separates them:
#    * SECRETS  -> masked in logs, do not echo
#    * VARIABLES-> visible in logs, non-sensitive only
# =============================================================================


# =============================================================================
#  SECRETS  (Settings -> Variables and Secrets -> NEW SECRET)
# =============================================================================

# ---- HTTP password gate (REQUIRED) ----------------------------------------
# Everything except /health is behind this. Generate a strong one:
#     python -c "import secrets;print(secrets.token_urlsafe(32))"
# If you leave it out the container invents a random one and prints it to the
# boot log ONCE - but then it changes on every restart, so set it properly.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=paste-a-32-char-random-string-here

# ---- Chhoto URL password (stack gate ke alawa, defence-in-depth) ----------
# Ye chhoto-url ke APNE login ke liye hai. Chhoda to boot pe ek RANDOM ban
# jaata hai aur boot log me ek baar print hota hai - chaahe to wahi use kar.
# STRICT: sirf A-Za-z0-9 aur 16+ characters. supervisord apni `environment=`
# line ko comma-separated KEY="value" parse karta hai, to comma/quote aaya to
# aage ki har variable chali jaayegi.
CHHOTO_PASSWORD=paste-a-32-char-alphanumeric-string

# ---- Backblaze B2 (no credit card required) -------------------------------
# https://backblaze.com/cloud-storage -> Start Free -> create a bucket,
# then App Keys -> Add Application Key (scope it to that bucket only).
B2_KEY_ID=your-application-key-id
B2_APP_KEY=your-application-key

# ---- restic encryption password (REQUIRED once backups matter) ------------
# Files are encrypted with this ON THIS MACHINE before upload, so Backblaze
# only ever stores unreadable blobs. LOSE THIS AND THE BACKUPS ARE GONE.
RESTIC_PASSWORD=paste-a-32-char-random-string-here

# ---- Miniflux database (REQUIRED for /rss/) -------------------------------
# Miniflux has no embedded database; PostgreSQL is mandatory.
# Neon free tier: 1 GB, no credit card. Append ?sslmode=require - required.
DATABASE_URL_MINIFLUX=postgresql://USER:PASS@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require


# =============================================================================
#  VARIABLES  (Settings -> Variables and Secrets -> NEW VARIABLE)
#  These are NOT sensitive - they appear in build and runtime logs.
# =============================================================================

# ---- Space identity (REQUIRED) --------------------------------------------
# Your public host, WITHOUT https:// and WITHOUT any path.
# Read it off the Space page: https://<SPACE_HOST>
#
# This one variable feeds every app's base-path setting:
#   PocketBase POCKETBASE_BASE_URL   -> https://<SPACE_HOST>/pb/
#   OpenList   SITE_URL              -> https://<SPACE_HOST>/files/
#   Miniflux   MINIFLUX_BASE_URL     -> https://<SPACE_HOST>/rss/
# Leave it out and every app loads but its CSS/JS 404s -> blank pages.
SPACE_HOST=yourname-privatestack.hf.space

# ---- Vaultwarden signups (crucial) ---------------------------------------
# true  = koi bhi /vw/ pe apna account bana sakta hai
# false = SIRF tumhara account, baaki sab ke liye registration band
# Apna pehla account banate hi isse false kar dena, phir compose restart.
VW_SIGNUPS=true

# ---- Backblaze B2 bucket + region endpoint (no card) ----------------------
# The endpoint is region specific - copy it from your B2 dashboard:
#   Buckets -> <your bucket> -> Endpoint
# It looks like: s3.us-west-004.backblazeb2.com
B2_BUCKET=your-bucket-name
B2_ENDPOINT=s3.us-west-004.backblazeb2.com


# =============================================================================
#  NOT environment variables at all.
#  These are created in each app's own web UI on first visit - putting them
#  in any file would just leak them to git.
#
#    PocketBase admin  ->  first visit to /pb/_/ shows the superuser form
#    OpenList   admin  ->  first visit to /files/ asks you to create it
#    Miniflux   admin  ->  first visit to /rss/ offers "Create account"
# =============================================================================


# =============================================================================
#  USED ONLY BY .github/workflows/keep-alive.yml  (a GitHub repository
#  variable, NOT a Hugging Face one):  Settings -> Actions -> Variables
# =============================================================================
# SPACE_HOST=yourname-privatestack.hf.space
